/**
 * DeviceManagerUtil - 设备管理工具类
 * 
 * 功能说明：
 * 1. 设备发现和列表管理
 * 2. 设备状态监听
 * 3. 跨端迁移发起
 * 4. 设备信息查询
 * 
 * 使用说明：
 * 1. 初始化时调用init()创建设备管理器
 * 2. 调用startDeviceDiscovery()开始发现设备
 * 3. 使用migrateTo()发起跨端迁移
 */

import { distributedDeviceManager } from '@kit.DistributedServiceKit';
import { common, UIAbility, Want, AbilityConstant } from '@kit.AbilityKit';
import { BusinessError } from '@kit.BasicServicesKit';
import Logger from './Logger';

const TAG: string = '[DeviceManagerUtil]';

/** 设备信息接口 */
export interface DeviceInfo {
  deviceId: string;           // 设备ID
  deviceName: string;         // 设备名称
  deviceType: string;         // 设备类型 (phone/tablet/tv/2in1/wearable)
  networkId: string;          // 网络ID
  isOnline: boolean;          // 是否在线
  isLocal: boolean;           // 是否为本机
}

/** 设备状态变化回调 */
export type DeviceStateCallback = (device: DeviceInfo, state: 'online' | 'offline' | 'changed') => void;

/** 设备发现回调 */
export type DeviceDiscoveryCallback = (devices: DeviceInfo[]) => void;

/**
 * 设备管理工具类（单例）
 */
export class DeviceManagerUtil {
  private static instance: DeviceManagerUtil;
  private dmManager: distributedDeviceManager.DeviceManager | null = null;
  private context: common.UIAbilityContext | null = null;
  private isInitialized: boolean = false;
  private isDiscovering: boolean = false;
  
  // 设备列表
  private deviceList: DeviceInfo[] = [];
  
  // 回调函数
  private deviceStateCallbacks: DeviceStateCallback[] = [];
  private deviceDiscoveryCallbacks: DeviceDiscoveryCallback[] = [];
  
  // 设备管理器包名
  private static readonly BUNDLE_NAME = 'com.huawei.effectkitsample';
  
  private constructor() {}
  
  /**
   * 获取单例实例
   */
  public static getInstance(): DeviceManagerUtil {
    if (!DeviceManagerUtil.instance) {
      DeviceManagerUtil.instance = new DeviceManagerUtil();
    }
    return DeviceManagerUtil.instance;
  }
  
  /**
   * 初始化设备管理器
   */
  public async init(context: common.UIAbilityContext): Promise<boolean> {
    if (this.isInitialized) {
      Logger.warn(TAG, 'DeviceManagerUtil already initialized');
      return true;
    }
    
    this.context = context;
    
    try {
      // 创建设备管理器
      this.dmManager = distributedDeviceManager.createDeviceManager(DeviceManagerUtil.BUNDLE_NAME);
      Logger.info(TAG, 'DeviceManager created successfully');
      
      // 注册设备状态变化监听
      this.registerDeviceStateListener();
      
      this.isInitialized = true;
      return true;
    } catch (error) {
      const err = error as BusinessError;
      Logger.error(TAG, `Failed to init DeviceManagerUtil. Code: ${err.code}, message: ${err.message}`);
      return false;
    }
  }
  
  /**
   * 注册设备状态变化监听
   */
  private registerDeviceStateListener(): void {
    if (!this.dmManager) {
      Logger.error(TAG, 'DeviceManager is null');
      return;
    }
    
    try {
      // 监听设备上线
      this.dmManager.on('deviceStateChange', (data: { action: distributedDeviceManager.DeviceStateChange; device: distributedDeviceManager.DeviceBasicInfo; }) => {
        Logger.info(TAG, `Device state changed: ${data.device.deviceId}, action: ${data.action}`);
        
        const deviceInfo = this.convertToDeviceInfo(data.device);
        
        // 更新设备列表
        if (data.action === distributedDeviceManager.DeviceStateChange.ONLINE) {
          // 设备上线
          const index = this.deviceList.findIndex(d => d.deviceId === deviceInfo.deviceId);
          if (index === -1) {
            this.deviceList.push(deviceInfo);
          } else {
            this.deviceList[index] = deviceInfo;
          }
          
          // 触发回调
          this.deviceStateCallbacks.forEach(callback => callback(deviceInfo, 'online'));
        } else if (data.action === distributedDeviceManager.DeviceStateChange.OFFLINE) {
          // 设备离线
          const index = this.deviceList.findIndex(d => d.deviceId === deviceInfo.deviceId);
          if (index > -1) {
            this.deviceList.splice(index, 1);
          }
          
          // 触发回调
          this.deviceStateCallbacks.forEach(callback => callback(deviceInfo, 'offline'));
        }
        
        // 触发发现回调
        this.deviceDiscoveryCallbacks.forEach(callback => callback([...this.deviceList]));
      });
      
      Logger.info(TAG, 'Device state listener registered');
    } catch (error) {
      const err = error as BusinessError;
      Logger.error(TAG, `Failed to register device state listener. Code: ${err.code}, message: ${err.message}`);
    }
  }
  
  /**
   * 开始发现设备
   */
  public startDeviceDiscovery(): boolean {
    if (!this.dmManager) {
      Logger.error(TAG, 'DeviceManager is null');
      return false;
    }
    
    if (this.isDiscovering) {
      Logger.warn(TAG, 'Already discovering devices');
      return true;
    }
    
    try {
      const subscribeInfo: distributedDeviceManager.SubscribeInfo = {
        subscribeId: Date.now(),
        mode: distributedDeviceManager.DiscoverMode.DISCOVER_ACTIVE,
        medium: distributedDeviceManager.ExchangeMedium.AUTO,
        freq: distributedDeviceManager.ExchangeFreq.MID,
        isSameAccount: false,
        isWakeRemote: true,
        capability: distributedDeviceManager.SubscribeCapability.SUBSCRIBE_CAPABILITY_ALL
      };
      
      this.dmManager.startDeviceDiscovery(subscribeInfo);
      this.isDiscovering = true;
      
      Logger.info(TAG, 'Device discovery started');
      return true;
    } catch (error) {
      const err = error as BusinessError;
      Logger.error(TAG, `Failed to start device discovery. Code: ${err.code}, message: ${err.message}`);
      return false;
    }
  }
  
  /**
   * 停止发现设备
   */
  public stopDeviceDiscovery(): void {
    if (!this.dmManager || !this.isDiscovering) {
      return;
    }
    
    try {
      this.dmManager.stopDeviceDiscovery({
        subscribeId: Date.now()
      });
      this.isDiscovering = false;
      
      Logger.info(TAG, 'Device discovery stopped');
    } catch (error) {
      const err = error as BusinessError;
      Logger.error(TAG, `Failed to stop device discovery. Code: ${err.code}, message: ${err.message}`);
    }
  }
  
  /**
   * 获取在线设备列表
   */
  public getOnlineDevices(): DeviceInfo[] {
    return [...this.deviceList];
  }
  
  /**
   * 获取本地设备信息
   */
  public getLocalDeviceInfo(): DeviceInfo | null {
    if (!this.dmManager) {
      Logger.error(TAG, 'DeviceManager is null');
      return null;
    }
    
    try {
      const localDevice: distributedDeviceManager.DeviceBasicInfo = this.dmManager.getLocalDeviceInfo();
      return this.convertToDeviceInfo(localDevice, true);
    } catch (error) {
      const err = error as BusinessError;
      Logger.error(TAG, `Failed to get local device info. Code: ${err.code}, message: ${err.message}`);
      return null;
    }
  }
  
  /**
   * 发起跨端迁移
   * @param deviceId 目标设备ID
   */
  public async migrateTo(deviceId: string): Promise<boolean> {
    if (!this.context) {
      Logger.error(TAG, 'Context is null');
      return false;
    }
    
    try {
      Logger.info(TAG, `Starting migration to device: ${deviceId}`);
      
      // 构造迁移Want
      const want: Want = {
        deviceId: deviceId,
        bundleName: this.context.applicationInfo.name,
        abilityName: 'EntryAbility',
        moduleName: 'entry'
      };

      // 构造启动选项
      const startOptions: common.StartOptions = {
        displayId: 0
      };
      
      // 发起迁移
      await this.context.startAbility(want, startOptions);
      
      Logger.info(TAG, 'Migration started successfully');
      return true;
    } catch (error) {
      const err = error as BusinessError;
      Logger.error(TAG, `Failed to migrate. Code: ${err.code}, message: ${err.message}`);
      return false;
    }
  }
  
  /**
   * 发起跨端Ability调用（用于协同）
   * @param deviceId 目标设备ID
   * @param action 操作类型
   * @param params 参数
   */
  public async startAbilityOnDevice(
    deviceId: string,
    action: string,
    params: Record<string, Object> = {}
  ): Promise<boolean> {
    if (!this.context) {
      Logger.error(TAG, 'Context is null');
      return false;
    }
    
    try {
      const want: Want = {
        deviceId: deviceId,
        bundleName: this.context.applicationInfo.name,
        abilityName: 'EntryAbility',
        moduleName: 'entry',
        action: action,
        parameters: params
      };
      
      await this.context.startAbility(want);
      
      Logger.info(TAG, `Ability started on device ${deviceId} with action ${action}`);
      return true;
    } catch (error) {
      const err = error as BusinessError;
      Logger.error(TAG, `Failed to start ability on device. Code: ${err.code}, message: ${err.message}`);
      return false;
    }
  }
  
  /**
   * 订阅设备状态变化
   */
  public onDeviceStateChange(callback: DeviceStateCallback): void {
    this.deviceStateCallbacks.push(callback);
  }
  
  /**
   * 订阅设备发现
   */
  public onDeviceDiscovery(callback: DeviceDiscoveryCallback): void {
    this.deviceDiscoveryCallbacks.push(callback);
  }
  
  /**
   * 取消订阅设备状态变化
   */
  public offDeviceStateChange(callback: DeviceStateCallback): void {
    const index = this.deviceStateCallbacks.indexOf(callback);
    if (index > -1) {
      this.deviceStateCallbacks.splice(index, 1);
    }
  }
  
  /**
   * 取消订阅设备发现
   */
  public offDeviceDiscovery(callback: DeviceDiscoveryCallback): void {
    const index = this.deviceDiscoveryCallbacks.indexOf(callback);
    if (index > -1) {
      this.deviceDiscoveryCallbacks.splice(index, 1);
    }
  }
  
  /**
   * 转换设备信息格式
   */
  private convertToDeviceInfo(
    device: distributedDeviceManager.DeviceBasicInfo,
    isLocal: boolean = false
  ): DeviceInfo {
    return {
      deviceId: device.deviceId,
      deviceName: device.deviceName,
      deviceType: this.getDeviceTypeString(Number(device.deviceType)),
      networkId: device.networkId || '',
      isOnline: true,
      isLocal: isLocal
    };
  }
  
  /**
   * 获取设备类型字符串
   */
  private getDeviceTypeString(deviceType: number): string {
    switch (deviceType) {
      case distributedDeviceManager.DeviceType.DEVICE_TYPE_PHONE:
        return 'phone';
      case distributedDeviceManager.DeviceType.DEVICE_TYPE_TABLET:
        return 'tablet';
      case distributedDeviceManager.DeviceType.DEVICE_TYPE_TV:
        return 'tv';
      case distributedDeviceManager.DeviceType.DEVICE_TYPE_2IN1:
        return '2in1';
      case distributedDeviceManager.DeviceType.DEVICE_TYPE_WATCH:
        return 'wearable';
      default:
        return 'unknown';
    }
  }
  
  /**
   * 释放资源
   */
  public release(): void {
    try {
      this.stopDeviceDiscovery();
      
      if (this.dmManager) {
        // 注销所有监听
        this.dmManager.off('deviceStateChange');
      }
      
      this.dmManager = null;
      this.isInitialized = false;
      this.deviceList = [];
      this.deviceStateCallbacks = [];
      this.deviceDiscoveryCallbacks = [];
      
      Logger.info(TAG, 'DeviceManagerUtil released');
    } catch (error) {
      const err = error as BusinessError;
      Logger.error(TAG, `Failed to release. Code: ${err.code}, message: ${err.message}`);
    }
  }
  
  /**
   * 检查是否已初始化
   */
  public isReady(): boolean {
    return this.isInitialized && this.dmManager !== null;
  }
  
  /**
   * 检查是否正在发现设备
   */
  public isDiscoveringDevices(): boolean {
    return this.isDiscovering;
  }
}

export default DeviceManagerUtil;
