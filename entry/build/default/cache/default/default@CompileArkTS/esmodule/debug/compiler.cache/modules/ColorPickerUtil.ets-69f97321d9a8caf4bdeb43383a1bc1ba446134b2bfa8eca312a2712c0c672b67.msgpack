    } else if (hsl.l > 0.7) {
      brightnessScore = (1 - hsl.l) / 0.3 * 0.7;
    } else {
      brightnessScore = 1.0;
    }
    
    return saturationScore * 0.6 + brightnessScore * 0.4;
  }

